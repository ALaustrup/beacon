# Beacon environment matrix.
# Copy to .env.local for machine-local overrides (gitignored).
# Never put secrets in VITE_* variables — those are inlined into the client.

# --- Server-only (Vercel / Node). Never expose to web or Capacitor. ---

# Postgres connection. Unset → in-memory PGLite (local / Preview fallback).
# When set for production, use a pooler URI. Do not use the Postgres superuser
# as the long-term app role once RLS is enforced on the server path.
DATABASE_URL=

# Session signing. Required in Production. Preview mints a per-instance secret
# if unset (sessions will not survive instance recycle).
BETTER_AUTH_SECRET=

# Public origin of this deployment (https://…). Preview can omit this; the
# server also trusts *.vercel.app and uses VERCEL_URL when present.
BETTER_AUTH_URL=

# Explicit demo theater. true|1 → labeled DEMO seeds/rows. false|0 → hide them.
# Unset → on unless NODE_ENV=production. Production must be false.
BEACON_DEMO=

# Reserved rollback switch (Phase 3+). pglite | supabase
# BEACON_PERSISTENCE=

# Federated sign-in via the Grok auth broker. Required for Google/X on a
# deployed origin. Unset falls back to the grok-sandbox preview client.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_AUTH_ISSUER=

# Optional translation upgrade. Unset → MyMemory fallback.
XAI_API_KEY=

# Supabase admin. Seed/migration/ops only. Never VITE_, never the client.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# --- Intentionally public (compiled into the browser / Capacitor WebView) ---

# "false" forces the shared local dev user. Do not set false in Production.
VITE_AUTH_ENABLED=

# Optional OG / canonical hostname.
VITE_PUBLIC_HOSTNAME=

# Optional STUN servers for later WebRTC. Unused in Phase 1–2.
VITE_STUN_URLS=

# Client Realtime/Broadcast only. The anon/publishable key is not a secret;
# RLS must hold. Do not add a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev-only live transport. poll keeps the existing interval. Default later: broadcast.
# VITE_LIVE_TRANSPORT=poll
